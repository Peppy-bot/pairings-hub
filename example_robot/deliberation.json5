{
  peppy_schema: "pairing/v1",
  manifest: {
    name: "deliberation",
    tag: "v1",
    description: [
      "Split-compute manipulation: the conversation between a slow deliberative planner and the fast reactive policy, the executor, that executes against real hardware.",
      "The executor pushes what it is facing up, and the planner pushes subgoals back down. Each side holds a pinned view of exactly one counterpart, and neither direction blocks on the other."
    ]
  },
  // This is a pairing rather than two producer links because the relationship
  // is bidirectional and exclusive. Neither direction blocks on the other,
  // which is what keeps the two safe to hide from the dependency graph.
  roles: ["planner", "executor"],
  topics: [
    {
      emitted_by: "executor",
      name: "situation",
      description: "What the executor is facing, at its own rate: its joint positions, the subgoal that it servos on, and whether it asks the planner for a subgoal.",
      // A stream sampled at the executor's own rate. A planner that misses one
      // sample wants the next one, not a replay of the last.
      qos_profile: "sensor_data",
      message_format: {
        timestamp: "time",
        joint_positions: {
          $type: "array",
          $items: "f64",
          $length: 3
        },
        active_subgoal_id: {
          $type: "u32",
          $description: "The subgoal the executor is currently servoing on, echoed back from `subgoal.subgoal_id`, or 0 when nothing is authoritative. Adoption is reported by the side that adopts rather than inferred by the side that sent: delivery is not adoption, and an adopted subgoal can lapse on the executor's own staleness bound without the planner sending anything. This field is also what lets a third party watching this role tell a newly adopted subgoal from a redelivery of the previous one."
        },
        escalated: {
          $type: "bool",
          $description: "Set when the executor could not resolve what it is facing inside its own horizon and is asking the planner for a subgoal. The stream runs either way, so the planner always has recent state to plan against."
        }
      }
    },
    {
      emitted_by: "planner",
      name: "subgoal",
      description: "A subgoal for the executor: the position to go to and how far ahead the planner planned it. Each subgoal has its own subgoal_id; 0 is not a subgoal_id, because the executor reports 0 when no subgoal is authoritative.",
      // Low rate and individually meaningful: dropping one costs the executor
      // a whole planning cycle, so this direction is reliable.
      qos_profile: "reliable",
      message_format: {
        timestamp: "time",
        subgoal_id: "u32",
        target_position: {
          $type: "array",
          $items: "f64",
          $length: 3
        },
        horizon_s: {
          $type: "f64",
          $description: "How far ahead the planner planned. The executor weighs this against its own staleness bound when deciding how long to keep trusting the subgoal after the uplink goes quiet."
        }
      }
    }
  ]
}
