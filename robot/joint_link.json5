{
  peppy_schema: "pairing/v1",
  manifest: {
    name: "joint_link",
    tag: "v1",
    description: [
      "The exclusive control conversation between one leader instance and one jointed device (an arm or any actuated kinematic chain), as a pairing: the leader streams the desired joint setpoint and the follower streams its measured joint state back, both directions scoped to the pair.",
      "A gripper opening is not a joint vector and a pose is not a joint vector; they have their own gripper_link and pose_link pairings.",
      "Joint conventions, identical in both directions: vectors are index-aligned across positions, velocities and efforts, and carry one entry per joint in the device's fixed joint order. positions are radians (revolute) or meters (prismatic). velocities are rad/s or m/s; empty when not commanded or not measured. efforts are N*m (revolute) or N (prismatic); empty when not commanded or not sensed.",
      "Joint names, order, and revolute/prismatic kinds are fixed properties of the device, not carried per message.",
    ],
  },
  roles: ["leader", "follower"],
  topics: [
    {
      emitted_by: "leader",
      name: "joint_setpoints",
      description: "The joint setpoint that the leader wants: the joint positions, with optional feedforward velocities and efforts.",
      // High-frequency stream where only the latest setpoint matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        timestamp: { $type: "time", $description: "Leader-side capture time of this setpoint." },
        positions: { $type: "array", $items: "f64", $description: "Desired joint positions." },
        velocities: { $type: "array", $items: "f64", $description: "Desired joint velocities (feedforward)." },
        efforts: { $type: "array", $items: "f64", $description: "Desired joint efforts (feedforward)." },
      },
    },
    {
      emitted_by: "follower",
      name: "joint_states",
      description: "The joint state that the follower measures: its joint positions and, when it measures them, its joint velocities and efforts.",
      // High-frequency stream where only the latest state matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        timestamp: { $type: "time", $description: "Follower-side capture time of this measurement." },
        positions: { $type: "array", $items: "f64", $description: "Measured joint positions." },
        velocities: { $type: "array", $items: "f64", $description: "Measured joint velocities." },
        efforts: { $type: "array", $items: "f64", $description: "Measured joint efforts." },
      },
    },
  ],
}
