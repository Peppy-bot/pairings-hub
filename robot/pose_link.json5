{
  peppy_schema: "pairing/v1",
  manifest: {
    name: "pose_link",
    tag: "v1",
    description: [
      "The exclusive Cartesian control conversation between one leader instance and one device's end-effector, as a pairing: the leader streams the desired pose and the follower streams its measured pose back, both directions scoped to the pair.",
      "A joint vector is not a pose; it has its own joint_link pairing.",
      "Pose conventions, identical in both directions: position is meters, [x, y, z]. orientation is a unit quaternion [x, y, z, w], scalar last. Both are in the follower's world frame; the frame, the end-effector link, and the kinematic chain are fixed properties of the follower, not carried per message.",
    ],
  },
  roles: ["leader", "follower"],
  topics: [
    {
      emitted_by: "leader",
      name: "pose_setpoints",
      description: "The end-effector pose that the leader wants, in the world frame of the follower.",
      // High-frequency stream where only the latest setpoint matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        timestamp: { $type: "time", $description: "Leader-side capture time of this setpoint." },
        position: { $type: "array", $items: "f64", $length: 3, $description: "Desired end-effector position." },
        orientation: { $type: "array", $items: "f64", $length: 4, $description: "Desired end-effector orientation." },
      },
    },
    {
      emitted_by: "follower",
      name: "pose_states",
      description: "The end-effector pose that the follower measures, in its world frame.",
      // High-frequency stream where only the latest state matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        timestamp: { $type: "time", $description: "Follower-side capture time of this measurement." },
        position: { $type: "array", $items: "f64", $length: 3, $description: "Measured end-effector position." },
        orientation: { $type: "array", $items: "f64", $length: 4, $description: "Measured end-effector orientation." },
      },
    },
  ],
}
