{
  peppy_schema: "pairing/v1",
  manifest: {
    name: "pose_link",
    tag: "v1",
    description: [
      "The exclusive Cartesian control conversation between one leader instance and one device's end-effector, as a pairing: the leader streams the desired pose and the follower streams its measured pose back, both directions scoped to the pair.",
      "A joint vector is not a pose; it has its own joint_link pairing.",
      "Pose conventions, identical in both directions: each message is a pose of the follower's end-effector with its frame and its timestamp, position in meters, [x, y, z], and orientation a unit quaternion [x, y, z, w], scalar last. pose_states gives the follower's robot frame, the robot frame of transforms. Timestamps are on the clock of transforms, which the follower's instance reads, the simulation clock in a simulation. The follower places each setpoint by its tree at its timestamp, as transforms defines a lookup: a setpoint in the robot frame names where the robot frame stood at its timestamp. A setpoint with no timestamp is placed by the latest transforms when the follower takes it; a setpoint in the robot frame with no timestamp names where the robot frame stands then. A leader that means a pose relative to the robot frame as it stands leaves the timestamp out, and so does a leader whose clock is not the clock of transforms. A setpoint that the follower cannot place, and one whose orientation's squared norm lies 0.01 or more from 1, the tolerance of tf2's buffer that transforms names, count as no setpoint: the follower drops them, and normalizes each orientation it takes. The end-effector link and the kinematic chain are fixed properties of the follower.",
    ],
  },
  roles: ["leader", "follower"],
  topics: [
    {
      emitted_by: "leader",
      name: "pose_setpoints",
      description: "The end-effector pose that the leader wants, given in frame at timestamp, which the follower places as the pairing's description says.",
      // High-frequency stream where only the latest setpoint matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        frame: { $type: "string", $description: "The frame of the record's values, as transforms names frames." },
        timestamp: { $type: "time", $optional: true, $description: "The time on the clock of transforms at which the values hold. A command leaves it out for the latest time; a report leaves it out for values that hold at every time." },
        position: { $type: "array", $items: "f64", $length: 3, $description: "x, y, z (m)." },
        orientation: { $type: "array", $items: "f64", $length: 4, $description: "A unit quaternion [x, y, z, w]." },
      },
    },
    {
      emitted_by: "follower",
      name: "pose_states",
      description: "The end-effector pose that the follower measures, in frame, its robot frame, at timestamp, the time of the measurement.",
      // High-frequency stream where only the latest state matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        frame: { $type: "string", $description: "The frame of the record's values, as transforms names frames." },
        timestamp: { $type: "time", $description: "The time on the clock of transforms at which the values hold." },
        position: { $type: "array", $items: "f64", $length: 3, $description: "x, y, z (m)." },
        orientation: { $type: "array", $items: "f64", $length: 4, $description: "A unit quaternion [x, y, z, w]." },
      },
    },
  ],
}
