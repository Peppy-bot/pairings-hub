{
  peppy_schema: "pairing/v1",
  manifest: {
    name: "gripper_link",
    tag: "v1",
    description: [
      "The exclusive control conversation between one leader instance and one gripper, as a pairing: the leader streams the desired opening and the follower, the gripper, streams its measured opening and grip effort back, both directions scoped to the pair.",
      "Opening is a fraction of full travel (0 = closed, 1 = fully open), mechanism-independent: prismatic parallel jaws and revolute pinch fingers report the same quantity.",
    ],
  },
  roles: ["leader", "follower"],
  topics: [
    {
      emitted_by: "leader",
      name: "gripper_setpoints",
      description: "The opening that the leader wants, and the most effort that the follower can apply to get to it.",
      // High-frequency stream where only the latest setpoint matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        timestamp: { $type: "time", $description: "Leader-side capture time of this setpoint." },
        opening: { $type: "f64", $description: "Desired opening fraction, 0 = closed, 1 = fully open." },
        max_effort: {
          $type: "f64",
          $description: "Maximum effort the follower may exert toward the commanded opening (magnitude, in the follower's effort unit: the unit of gripper_states effort). 0 = no preference; the follower applies its configured ceiling.",
        },
      },
    },
    {
      emitted_by: "follower",
      name: "gripper_states",
      description: "The opening that the follower measures, its grip effort, and the effort ceiling that it applies.",
      // High-frequency stream where only the latest state matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        timestamp: { $type: "time", $description: "Follower-side capture time of this measurement." },
        opening: { $type: "f64", $description: "Measured opening fraction, 0 = closed, 1 = fully open." },
        effort: {
          $type: "f64",
          $description: "Measured grip effort in this follower's effort unit (e.g. N*m at the motor shaft, N at the jaws), in the opening frame: positive drives toward open, regardless of the mechanism's direction. 0.0 when the gripper does not sense effort.",
        },
        max_effort: {
          $type: "f64",
          $description: "Active effort ceiling (magnitude, same unit as effort): the largest effort that this follower exerts. 0 = no effort control.",
        },
      },
    },
  ],
}
