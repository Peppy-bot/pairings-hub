{
  peppy_schema: "pairing/v1",
  manifest: {
    name: "sim_rgb_camera_link",
    tag: "v1",
    description: [
      "The color-stream conversation between a simulation engine's rendered camera and one viewer, as a pairing: the camera streams frames plus low-rate descriptions of the stream and of its geometry, all scoped to the pair, and the viewer reads them.",
      "Message formats match the rgb_camera contract topic and video_stream_info response field for field, so a picture or descriptor can cross between the pairing and the contract surface unchanged. Each picture names in its header's frame the camera's frame: the frame that sensor_mounts' describe_sensors gives for the name the camera runs under, as rgb_camera's video_stream names it. geometry says where the camera's pixels point, which only the simulation knows, in the fields of the camera_geometry contract.",
      "Depth is not part of this conversation; a color + depth source uses sim_rgbd_camera_link.",
    ],
  },
  roles: ["camera", "viewer"],
  topics: [
    {
      emitted_by: "camera",
      name: "video_stream",
      description: "Each color picture that the camera renders, with the camera's frame, its capture time and its capture counter.",
      // High-frequency stream where only the latest frame matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        header: {
          $type: "object",
          $description: "The camera's frame, the capture time and the capture counter of the picture.",
          frame: { $type: "string", $description: "The frame of the record's values, as transforms names frames; a twist beside a child_frame is in child_frame, and a sensor's values are in frame through the sensor's own geometry." },
          timestamp: { $type: "time", $description: "The time on the clock of transforms at which the values hold." },
          capture_index: { $type: "u32", $description: "The capture counter of the picture." },
        },
        encoding: { $type: "string", $description: "The pixel encoding of data, e.g. \"rgb8\", \"bgr8\", \"yuyv\" or \"mjpeg\"." },
        width: "u32",
        height: "u32",
        data: {
          $type: "array",
          $items: "u8",
        },
      },
    },
    {
      emitted_by: "camera",
      name: "stream_info",
      description: "Low-rate stream description: the size, frame rate and encoding of the stream. The latest value describes the current stream.",
      qos_profile: "standard",
      message_format: {
        width: "u32",
        height: "u32",
        frames_per_second: "u8",
        encoding: "string",
      },
    },
    {
      emitted_by: "camera",
      name: "geometry",
      description: "Low-rate description of where the camera's pixels point; the latest value describes the current stream. Fields match the camera_geometry contract's get_color_intrinsics response field for field, under that contract's conventions: width, height, fx, fy, cx and cy are the pinhole model of the colour stream at its published size, focal lengths and principal point in pixels.",
      qos_profile: "standard",
      message_format: {
        width: "u32",
        height: "u32",
        fx: "f64",
        fy: "f64",
        cx: "f64",
        cy: "f64",
        distortion_model: { $type: "string", $description: "The distortion model: \"none\" for a rendered image." },
        distortion: { $type: "array", $items: "f64", $description: "The coefficients of the distortion model; empty for \"none\"." },
      },
    },
  ],
}
