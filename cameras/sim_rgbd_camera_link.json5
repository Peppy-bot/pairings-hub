// The color + depth conversation between a simulation engine's rendered
// camera and one viewer, as a pairing: the camera streams synchronized color
// and depth frames plus a low-rate description of both streams, all scoped
// to the pair. Color
// and depth share a frame_id (a capture-pair counter, not a coordinate frame)
// so consumers can correlate paired frames without timestamp matching. Frame
// messages match the rgbd_camera contract topics field for field, so frames
// cross between the pairing and the contract surface unchanged. stream_info
// merges both contract stream-info responses into one message; the single
// frames_per_second covers both streams, since color and depth are captured
// as pairs. geometry says where the camera's pixels point, what a depth
// sample measures and how the depth stream sits against the colour one,
// which only the simulation knows, in the fields of the camera_geometry
// contract. A color-only source uses sim_rgb_camera_link.
{
  peppy_schema: "pairing/v1",
  manifest: {
    name: "sim_rgbd_camera_link",
    tag: "v1",
  },
  roles: ["camera", "viewer"],
  topics: [
    {
      emitted_by: "camera",
      name: "video_stream",
      // High-frequency stream where only the latest frame matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        header: {
          $type: "object",
          // Capture time of this frame.
          timestamp: "time",
          // Capture-pair counter shared with the matching depth frame.
          frame_id: "u32",
          align_mode: "string",   // e.g. "none" | "depth_to_color" | "color_to_depth"
        },
        encoding: "string",   // e.g. "rgb8" | "bgr8" | "yuyv" | "mjpeg"
        width: "u32",
        height: "u32",
        frame: {
          $type: "array",
          $items: "u8",
        },
      },
    },
    {
      emitted_by: "camera",
      name: "depth_stream",
      // High-frequency stream where only the latest frame matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        header: {
          $type: "object",
          // Capture time of this frame.
          timestamp: "time",
          // Capture-pair counter shared with the matching color frame.
          frame_id: "u32",
          align_mode: "string",   // e.g. "none" | "depth_to_color" | "color_to_depth"
        },
        encoding: "string",   // e.g. "z16" (u16 little-endian)
        width: "u32",
        height: "u32",
        frame: {
          $type: "array",
          $items: "u8",
        },
      },
    },
    {
      emitted_by: "camera",
      name: "stream_info",
      // Low-rate stream description; latest value describes both current streams.
      qos_profile: "standard",
      message_format: {
        width: "u32",
        height: "u32",
        frames_per_second: "u8",
        encoding: "string",
        depth_width: "u32",
        depth_height: "u32",
        depth_encoding: "string",
        depth_unit: "f32",   // meters per LSB, e.g. 0.001 = 1mm
      },
    },
    {
      emitted_by: "camera",
      name: "geometry",
      // Low-rate description of where the camera's pixels point, what its
      // depth samples measure and how depth sits against colour; latest
      // value describes both current streams. It merges the
      // camera_geometry contract's get_color_intrinsics,
      // get_depth_intrinsics and get_depth_to_color_extrinsics responses
      // field for field, the depth intrinsics prefixed, under that
      // contract's conventions.
      qos_profile: "standard",
      message_format: {
        // Pinhole model of the colour stream at its published size: focal
        // lengths and principal point in pixels.
        width: "u32",
        height: "u32",
        fx: "f64",
        fy: "f64",
        cx: "f64",
        cy: "f64",
        distortion_model: "string",   // "none" for a rendered image
        distortion: { $type: "array", $items: "f64" },
        // The same for the depth stream at its own size.
        depth_width: "u32",
        depth_height: "u32",
        depth_fx: "f64",
        depth_fy: "f64",
        depth_cx: "f64",
        depth_cy: "f64",
        depth_distortion_model: "string",
        depth_distortion: { $type: "array", $items: "f64" },
        // "z": a sample is the distance to the plane through the point,
        // square to the optical axis, which is what a renderer's depth
        // buffer gives.
        depth_model: "string",
        // The depths the stream reports, metres; a sample outside them is 0.
        min_depth_m: "f64",
        max_depth_m: "f64",
        // The alignment the frames carry. A rendered depth comes from the
        // colour camera's own viewpoint, so this is "depth_to_color" and the
        // pose below is the identity.
        align_mode: "string",
        // The depth optical frame in the colour optical frame: x, y, z (m)
        // and a unit quaternion [x, y, z, w].
        depth_to_color_position: { $type: "array", $items: "f64", $length: 3 },
        depth_to_color_orientation: { $type: "array", $items: "f64", $length: 4 },
      },
    },
  ],
}
