{
  peppy_schema: "pairing/v1",
  manifest: {
    name: "sim_rgbd_camera_link",
    tag: "v1",
    description: [
      "The color + depth conversation between a simulation engine's rendered camera and one viewer, as a pairing: the camera streams synchronized color and depth frames plus low-rate descriptions of both streams and of their geometry, all scoped to the pair, and the viewer reads them.",
      "Color and depth share a frame_id (a capture-pair counter, not a coordinate frame) so consumers can correlate paired frames without timestamp matching. Frame messages match the rgbd_camera contract topics field for field, so frames cross between the pairing and the contract surface unchanged. stream_info merges both contract stream-info responses into one message; the single frames_per_second covers both streams, since color and depth are captured as pairs.",
      "geometry says where the camera's pixels point, what a depth sample measures and how the depth stream sits against the colour one, which only the simulation knows, in the fields of the camera_geometry contract.",
      "A color-only source uses sim_rgb_camera_link.",
    ],
  },
  roles: ["camera", "viewer"],
  topics: [
    {
      emitted_by: "camera",
      name: "video_stream",
      description: "Each color frame that the camera renders. It shares its frame_id with the depth frame of the same capture.",
      // High-frequency stream where only the latest frame matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        header: {
          $type: "object",
          timestamp: { $type: "time", $description: "Capture time of this frame." },
          frame_id: { $type: "u32", $description: "Capture-pair counter shared with the matching depth frame." },
          align_mode: { $type: "string", $description: "The alignment of the frame, e.g. \"none\", \"depth_to_color\" or \"color_to_depth\"." },
        },
        encoding: { $type: "string", $description: "The pixel encoding of the frame, e.g. \"rgb8\", \"bgr8\", \"yuyv\" or \"mjpeg\"." },
        width: "u32",
        height: "u32",
        frame: {
          $type: "array",
          $items: "u8",
        },
      },
    },
    {
      emitted_by: "camera",
      name: "depth_stream",
      description: "Each depth frame that the camera renders. It shares its frame_id with the color frame of the same capture.",
      // High-frequency stream where only the latest frame matters;
      // occasional drops are acceptable.
      qos_profile: "sensor_data",
      message_format: {
        header: {
          $type: "object",
          timestamp: { $type: "time", $description: "Capture time of this frame." },
          frame_id: { $type: "u32", $description: "Capture-pair counter shared with the matching color frame." },
          align_mode: { $type: "string", $description: "The alignment of the frame, e.g. \"none\", \"depth_to_color\" or \"color_to_depth\"." },
        },
        encoding: { $type: "string", $description: "The sample encoding of the frame, e.g. \"z16\" (u16 little-endian)." },
        width: "u32",
        height: "u32",
        frame: {
          $type: "array",
          $items: "u8",
        },
      },
    },
    {
      emitted_by: "camera",
      name: "stream_info",
      description: "Low-rate stream description: the size and encoding of the color stream and of the depth stream, the frame rate of both, and the depth unit. The latest value describes both current streams.",
      qos_profile: "standard",
      message_format: {
        width: "u32",
        height: "u32",
        frames_per_second: "u8",
        encoding: "string",
        depth_width: "u32",
        depth_height: "u32",
        depth_encoding: "string",
        depth_unit: { $type: "f32", $description: "Meters per LSB of a depth sample, e.g. 0.001 = 1mm." },
      },
    },
    {
      emitted_by: "camera",
      name: "geometry",
      description: "Low-rate description of where the camera's pixels point, what its depth samples measure and how depth sits against colour; the latest value describes both current streams. It merges the camera_geometry contract's get_color_intrinsics, get_depth_intrinsics and get_depth_to_color_extrinsics responses field for field, the depth intrinsics prefixed, under that contract's conventions: width, height, fx, fy, cx and cy are the pinhole model of the colour stream at its published size, focal lengths and principal point in pixels, and the depth_ fields of the same names are the same for the depth stream at its own size.",
      qos_profile: "standard",
      message_format: {
        width: "u32",
        height: "u32",
        fx: "f64",
        fy: "f64",
        cx: "f64",
        cy: "f64",
        distortion_model: { $type: "string", $description: "The distortion model of the colour stream: \"none\" for a rendered image." },
        distortion: { $type: "array", $items: "f64", $description: "The coefficients of the colour distortion model; empty for \"none\"." },
        depth_width: "u32",
        depth_height: "u32",
        depth_fx: "f64",
        depth_fy: "f64",
        depth_cx: "f64",
        depth_cy: "f64",
        depth_distortion_model: { $type: "string", $description: "The distortion model of the depth stream: \"none\" for a rendered image." },
        depth_distortion: { $type: "array", $items: "f64", $description: "The coefficients of the depth distortion model; empty for \"none\"." },
        depth_model: {
          $type: "string",
          $description: "What a depth sample measures: \"z\", the distance to the plane through the point, square to the optical axis, which is what a renderer's depth buffer gives.",
        },
        min_depth_m: { $type: "f64", $description: "The smallest depth the stream reports, metres; a sample nearer than it is 0." },
        max_depth_m: { $type: "f64", $description: "The largest depth the stream reports, metres; a sample farther than it is 0." },
        align_mode: {
          $type: "string",
          $description: "The alignment the frames carry. A rendered depth comes from the colour camera's own viewpoint, so this is \"depth_to_color\" and the pose in depth_to_color_position and depth_to_color_orientation is the identity.",
        },
        depth_to_color_position: {
          $type: "array",
          $items: "f64",
          $length: 3,
          $description: "The position of the depth optical frame in the colour optical frame: x, y, z (m).",
        },
        depth_to_color_orientation: {
          $type: "array",
          $items: "f64",
          $length: 4,
          $description: "The orientation of the depth optical frame in the colour optical frame: a unit quaternion [x, y, z, w].",
        },
      },
    },
  ],
}
